{
  "name": "@odls/core-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "OIDC_ISSUER_URL=https://identity.test OIDC_AUDIENCE=odls-test vitest run",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/src/server.js",
    "worker:start": "node dist/src/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "worker:build": "tsc -p tsconfig.json",
    "worker:typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:test": "OIDC_ISSUER_URL=https://identity.test OIDC_AUDIENCE=odls-test vitest run test/notification-*.test.ts",
    "worker:lint": "eslint src/application/notification src/domain/notification src/infrastructure/notification src/worker.ts --max-warnings=0",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:status": "tsx scripts/migrate.ts --status",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "9.3.0",
    "@odls/contracts": "workspace:*",
    "@odls/platform": "workspace:*",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "@tesseract.js-data/rus": "^1.0.0",
    "@tesseract.js-data/ukr": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "openai": "6.39.0",
    "pg": "^8.16.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.2",
    "@types/pg": "^8.15.1",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^9.25.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
