NODE_ENV=development
LOG_LEVEL=info
GATEWAY_PORT=3000
CORE_SERVICE_PORT=3001
CORE_SERVICE_URL=http://localhost:3001
OIDC_ISSUER_URL=https://identity.example.com
OIDC_AUDIENCE=odls-api
OTEL_SERVICE_NAME=odls-platform
DATABASE_URL=postgresql://odls:odls@localhost:5432/odls
JWT_SECRET=replace-with-a-32-character-development-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DOCUMENT_STORAGE_ROOT=/tmp/odls-documents
DOCUMENT_MAX_BYTES=10485760
SCANNER_MAX_UPLOAD_BYTES=26214400
SCANNER_MAX_IMAGE_PIXELS=40000000
SCANNER_MAX_IMAGE_DIMENSION=12000
SCANNER_OUTPUT_JPEG_QUALITY=88
OCR_MAX_INPUT_BYTES=20971520
OCR_MAX_TEXT_CHARACTERS=250000
OCR_TIMEOUT_MS=120000
OCR_MAX_ATTEMPTS=3
OCR_MAX_LANGUAGES=4
OCR_STUCK_JOB_MS=600000
OCR_WORKER_BATCH_SIZE=1
ANALYSIS_MAX_TEXT_CHARACTERS=500000
ANALYSIS_MAX_FIELDS=100
ANALYSIS_MAX_FIELD_LENGTH=2000
ANALYSIS_TIMEOUT_MS=30000
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_STUCK_JOB_MS=600000
ANALYSIS_WORKER_BATCH_SIZE=1
CLASSIFICATION_MIN_CONFIDENCE=0.45
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=omnira-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=omnira-local
MINIO_ROOT_PASSWORD=replace-with-a-local-development-password
